---
import type { Project } from '../utils/projects-data';

export interface Props {
  project: Project;
}

const { project } = Astro.props;

// Determine badge color based on category
let categoryBadgeColor = 'bg-primary-100 text-primary-800'; // Default for all categories

// Determine status badge color
let statusBadgeColor = 'bg-primary-500 text-white'; // Default for all statuses
---
<div class="border border-gray-200 rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 flex flex-col h-full transform hover:-translate-y-1 hover:border-primary-200 group">
  <div class="relative h-[250px] overflow-hidden">
    <img 
      src={project.mainImage} 
      alt={`Imagen de ${project.name}`} 
      class="w-full h-full object-cover transition-transform duration-500 ease-in-out group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
    <span class="absolute top-4 right-4 px-3 py-1 text-xs font-medium rounded-full bg-primary-500 text-white shadow-md font-subheading group-hover:shadow-lg transition-shadow duration-300">
      {project.status}
    </span>
  </div>
  <div class="p-6 flex flex-col h-full">
    <p class="text-sm font-medium bg-primary-100 text-primary-800 px-3 py-0.5 rounded-full inline-block mb-2 font-subheading shadow-sm group-hover:shadow group-hover:bg-primary-200 transition-all duration-300">
      {project.category}
    </p>
    <h3 class="text-xl font-semibold text-gray-900 mb-2 font-subheading group-hover:text-primary-600 transition-colors duration-300">
      {project.name}
    </h3>
    <p class="text-gray-600 mb-4 flex-grow group-hover:text-gray-800 transition-colors duration-300">{project.shortDescription}</p>
    <div class="pt-2 border-t border-gray-100 mt-auto">
      <span class="text-primary-600 group-hover:text-primary-700 font-medium inline-flex items-center font-subheading">
        Ver detalles 
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 transform group-hover:translate-x-2 transition-transform duration-300 ease-in-out" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </span>
    </div>
  </div>
</div>
